# ---------------------------------------------------------------------------
# Dossier ab[B]ruzzo — variabili d'ambiente
#
# In locale: copia questo file in .env.local e riempilo.
# Su Vercel: incolla le stesse variabili in Settings → Environment Variables.
# Nessuno di questi valori va mai messo nel repository.
# ---------------------------------------------------------------------------

# --- Supabase -------------------------------------------------------------
# Dalla dashboard del progetto: Settings → API.

# L'indirizzo del progetto, per esempio https://abcdefghijkl.supabase.co
# È pubblico: arriva al browser insieme alla chiave anon.
NEXT_PUBLIC_SUPABASE_URL=

# Chiave "anon public". Arriva al browser, ma le policy RLS la limitano alla
# sola lettura, e il browser la riceve solo dopo la password perché il bundle
# è servito da rotte protette dal middleware. Serve ad ascoltare Realtime.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chiave "service_role". Scavalca RLS: resta sul server e non deve mai
# comparire in una variabile che comincia per NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Accesso --------------------------------------------------------------
# Generale entrambe con:  npm run hash-password

# L'hash scrypt della password condivisa. La password in chiaro non sta né qui
# né altrove: il server confronta solo l'hash.
DOSSIER_PASSWORD_HASH=

# Segreto con cui si firmano i cookie di sessione. Almeno 16 caratteri, meglio
# 32 casuali. Cambiandolo, tutti dovranno rifare la password.
SESSION_SECRET=
